APP_NAME=Subtitle AI Service
APP_ENV=development
BACKEND_INTERNAL_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379/0
MODEL_DEVICE=auto
WHISPER_MODEL=small
LLM_MODEL=qwen3
SUBTITLE_DB_MODE=mysql
SUBTITLE_WHISPER_MODEL=base
SUBTITLE_MODEL_DEVICE=cpu
# Optional local PhoWhisper GGML file in ai-service/data/models.
SUBTITLE_VI_ASR_CHECKPOINT=ggml-phowhisper-small-q5_0.bin
SUBTITLE_DB_HOST=127.0.0.1
SUBTITLE_DB_PORT=3306
SUBTITLE_DB_USER=
SUBTITLE_DB_PASSWORD=
SUBTITLE_REMOTE_GPU=false
SUBTITLE_WORKER_TOKEN=
SUBTITLE_LIVE_STREAM_URLS=[]
SUBTITLE_CONTEXT_TRANSLATION_URL=
SUBTITLE_CONTEXT_TRANSLATION_MODEL=
SUBTITLE_CONTEXT_TRANSLATION_TOKEN=
SUBTITLE_DENOISE_BINARY=
SUBTITLE_FFMPEG=
# Optional folder under ai-service/data/models for three-region Vietnamese classification.
SUBTITLE_DIALECT_CHECKPOINT=vn-dialect
